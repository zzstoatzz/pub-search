#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx", "pydantic-settings", "anthropic>=1"]
# ///
"""Evaluate candidate review models against known-truth accounts.

Replicates the classifier's vote material (facts + title sample + middle
excerpts, backend/src/ingest/classifier.zig fetchVoteMaterial) and prompt,
then runs each candidate model over each vote slice for every known account.
A usable judge must get ALL known cases right on a majority of votes.

Usage:
  scripts/judge-eval                                   # Anthropic, Haiku 5.5
  JUDGE_PROVIDER=anthropic scripts/judge-eval claude-haiku-5-5  # named model
  JUDGE_PROVIDER=openai scripts/judge-eval google/gemma-4-12b   # co/core (chat-completions)
  JUDGE_PROVIDER=openai JUDGE_API_URL=https://api.openai.com/v1/chat/completions scripts/judge-eval <model>
  JUDGE_API_URL=http://127.0.0.1:18081/v1/chat/completions JUDGE_API_KEY='' JUDGE_CONCURRENCY=1 scripts/judge-eval deepseek-local

Needs .env with turso_url/turso_token, and ANTHROPIC_API_KEY (or COCORE_API_KEY
for the openai provider) in the env or .env. ENV_FILE points at another file.
JUDGE_API_KEY overrides provider credentials; an empty value sends no auth header.
JUDGE_OUTPUT writes a JSON report with per-vote reasons, timings, and skipped cases.
JUDGE_MATERIALS saves the evidence used; an existing file replays it without database reads.
"""

import asyncio
import hashlib
import json
import os
import sys
import time
from pathlib import Path

import httpx
from pydantic_settings import BaseSettings, SettingsConfigDict

# Reviewed policy cases and corrections: docs/judge-evaluation.md.
KNOWN = {
    "did:plc:u5kk4h7tr4s3ntskbmhl5z7d": ("sksksketch.net", False),  # human illustrator
    "did:plc:5swhfspkrynnbidlkrkch3lh": ("prideraiser.org", False),  # original organizer writing
    "did:plc:4z33k5fjzw2ew3u373pg7ku5": ("festivus (episode catalog)", True),
    "did:plc:sttgf52vkk46f6yuknvqxvgh": ("coryd.dev (942-doc human)", False),  # volume trap
    "did:plc:77mn3ult3b72tpvtqqva6tat": ("frankhecker.com", False),
    "did:plc:rkjxbatkiros6f7pwtgsir54": ("den.dev", False),
    "did:plc:jgg4dtdflzzemyvnybucnzdw": ("chicagotransitalerts.app", True),
    "did:plc:esvvys4mvoclui34shb23l5w": ("eligundry.com (mood journal)", False),
}

PROVIDER = os.environ.get("JUDGE_PROVIDER", "anthropic")
DEFAULT_MODELS = {
    "anthropic": ["claude-haiku-5-5"],
    "openai": [
        "gpt-5.6-luna",  # previous production judge; use api.openai.com via JUDGE_API_URL
        "mlx-community/Qwen2.5-7B-Instruct-4bit",  # the original judge (baseline)
        "mlx-community/Qwen3.5-9B-MLX-4bit",
        "google/gemma-4-12b",  # the judge 2026-07-02 → 2026-09-05
        "mlx-community/Qwen3.6-35B-A3B-4bit",
    ],
}[PROVIDER]

VOTES = 3
TITLES_PER_VOTE = 30
EXCERPTS_PER_VOTE = 5
EXCERPT_LEN = 800

OPENAI_COMPAT_URL = os.environ.get("JUDGE_API_URL", "https://console.cocore.dev/api/v1/chat/completions")

PROMPT_HEAD = (Path(__file__).resolve().parents[1] / "backend/src/ingest/review_prompt.txt").read_text()

PROMPT_TAIL = """

Respond with ONLY JSON: {"machine": true|false, "reason": "<one sentence>"}"""


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=os.environ.get("ENV_FILE", ".env"), extra="ignore", hide_input_in_errors=True
    )
    turso_url: str
    turso_token: str
    cocore_api_key: str = ""
    openai_api_key: str = ""
    anthropic_api_key: str = ""

    @property
    def turso_host(self) -> str:
        url = self.turso_url
        return url[len("libsql://"):] if url.startswith("libsql://") else url


def _stmt(sql: str, args: list | None = None) -> dict:
    s: dict = {"sql": sql}
    if args:
        s["args"] = [{"type": "text", "value": str(a)} for a in args]
    return s


async def _execute(client: httpx.AsyncClient, st: Settings, sql: str, args=None) -> dict:
    r = await client.post(
        f"https://{st.turso_host}/v2/pipeline",
        headers={"Authorization": f"Bearer {st.turso_token}", "Content-Type": "application/json"},
        json={"requests": [{"type": "execute", "stmt": _stmt(sql, args)}, {"type": "close"}]},
        timeout=120,
    )
    r.raise_for_status()
    res = r.json()["results"][0]["response"]
    if res.get("type") == "error":
        raise RuntimeError(res["error"])
    return res["result"]


async def rows(client, st, sql, args=None) -> list[list]:
    res = await _execute(client, st, sql, args)
    return [[c.get("value") for c in row] for row in res.get("rows", [])]


def middle(s: str, max_len: int) -> str:
    data = s.encode("utf-8")
    if len(data) <= max_len:
        return s
    start = (len(data) - max_len) // 2
    while data[start] & 0xC0 == 0x80:
        start += 1
    return data[start : start + max_len].decode("utf-8", errors="ignore")


def excerpt_index(total: int, j: int, vote: int) -> int:
    base = (total * (2 * j + 1)) // (2 * EXCERPTS_PER_VOTE)
    return (base + vote) % total


def retained_material(did: str, vote: int) -> str | None:
    fixture = json.loads((Path(__file__).parent / "tests/fixtures/judge-festivus.json").read_text())
    if fixture["did"] != did:
        return None
    records = fixture["records"]
    picked = records[vote::VOTES]
    out = [f"Account sample: {len(records)} published native records; full account statistics unavailable.",
           "Titles from the retained sample:"]
    out += [f"- {record['title']}" for record in picked]
    excerpt = records[vote]
    out += ["\nDocument description excerpt:", f"- title: {excerpt['title']}\n  content: {excerpt['description_excerpt']}"]
    return "\n".join(out)


async def vote_material(client, st, did: str, vote: int) -> str:
    """Mirrors classifier.zig fetchVoteMaterial (turso instead of the replica)."""
    facts = (await rows(client, st,
        "SELECT COUNT(*), COALESCE(MIN(created_at),''), COALESCE(MAX(created_at),'') FROM documents WHERE did = ?",
        [did]))[0]
    total = int(facts[0])
    if total == 0:
        retained = retained_material(did, vote)
        if retained is not None:
            return retained
        raise RuntimeError(f"no documents for {did}")
    out = [f"Account facts: {total} documents, first {facts[1]}, latest {facts[2]}\n\nTitles across the account's history:"]

    titles = await rows(client, st,
        "SELECT title FROM documents WHERE did = ? ORDER BY created_at, rkey", [did])
    stride = max(total // TITLES_PER_VOTE, 1)
    phase = vote % stride
    picked = [t[0] for i, t in enumerate(titles) if i % stride == phase][:TITLES_PER_VOTE]
    out += [f"- {t}" for t in picked]

    out.append("\nContent excerpts (from the middle of documents):\n")
    for j in range(EXCERPTS_PER_VOTE):
        idx = excerpt_index(total, j, vote)
        doc = await rows(client, st,
            "SELECT title, content FROM documents WHERE did = ? ORDER BY created_at, rkey LIMIT 1 OFFSET ?",
            [did, idx])
        if doc:
            out.append(f"- title: {doc[0][0]}\n  content: {middle(doc[0][1] or '', EXCERPT_LEN)}\n")
    return "\n".join(out)


async def ask(client, st, model: str, material: str, usage: dict | None = None) -> tuple[bool | None, str]:
    try:
        return await _ask(client, st, model, material, usage)
    except httpx.HTTPError as e:
        return None, f"transport: {type(e).__name__}"


async def _ask(client, st, model: str, material: str, usage: dict | None = None) -> tuple[bool | None, str]:
    prompt = PROMPT_HEAD + material + PROMPT_TAIL
    timeout = float(os.environ.get("JUDGE_TIMEOUT", "90"))
    if PROVIDER == "anthropic":
        from anthropic import NOT_GIVEN, APIError, AsyncAnthropic

        anthropic = AsyncAnthropic(api_key=st.anthropic_api_key or None, timeout=timeout)
        async with anthropic:
            try:
                message = await anthropic.messages.create(
                    model=model,
                    max_tokens=4096,
                    output_config={"effort": os.environ.get("JUDGE_EFFORT", "medium")} if model == "claude-haiku-5-5" else NOT_GIVEN,
                    messages=[{"role": "user", "content": prompt}],
                )
            except APIError as exc:
                return None, f"anthropic: {type(exc).__name__}"
        content = "".join(block.text for block in message.content if block.type == "text")
        if usage is not None:
            usage.update(input_tokens=message.usage.input_tokens, output_tokens=message.usage.output_tokens,
                         stop_reason=message.stop_reason)
    else:
        body = {"model": model, "messages": [{"role": "user", "content": prompt}]}
        # openai's newer models reject `max_tokens` (it is `max_completion_tokens`,
        # and reasoning spends from it) and sampling parameters; co/core's models
        # take the older shape and think out loud, so both get room
        if "openai.com" in OPENAI_COMPAT_URL:
            body["max_completion_tokens"] = 6000
        else:
            body["max_tokens"] = 2000
            body["temperature"] = 0
        key = os.environ.get("JUDGE_API_KEY", st.openai_api_key if 'openai.com' in OPENAI_COMPAT_URL else st.cocore_api_key)
        r = await client.post(
            OPENAI_COMPAT_URL,
            headers={"Authorization": f"Bearer {key}"} if key else {},
            json=body,
            timeout=timeout,
        )
        if r.status_code != 200:
            return None, f"http {r.status_code}"
        response = r.json()
        content = (response.get("choices") or [{}])[0].get("message", {}).get("content", "")
        if usage is not None:
            usage.update(response.get("usage") or {})
    # the verdict is the LAST json object with a "machine" key — reasoning models
    # emit a thought stream (with stray braces) before it
    if not isinstance(content, str):
        return None, "missing text response"
    dec = json.JSONDecoder()
    verdict = None
    i = content.find("{")
    while i != -1:
        try:
            v, _ = dec.raw_decode(content, i)
            if isinstance(v, dict) and "machine" in v:
                verdict = v
        except json.JSONDecodeError:
            pass
        i = content.find("{", i + 1)
    if verdict is None or type(verdict["machine"]) is not bool:
        return None, f"unparseable: {content[:80]!r}"
    return verdict["machine"], str(verdict.get("reason", ""))


async def main() -> None:
    st = Settings()
    models = sys.argv[1:] or DEFAULT_MODELS
    async with httpx.AsyncClient() as client:
        # build all vote materials once (same evidence for every model)
        material_path = Path(os.environ["JUDGE_MATERIALS"]) if os.environ.get("JUDGE_MATERIALS") else None
        if material_path is not None and material_path.exists():
            materials = load_materials(material_path)
        else:
            materials = {}
            for did in KNOWN:
                try:
                    materials[did] = [await vote_material(client, st, did, v) for v in range(VOTES)]
                except RuntimeError as exc:
                    print(f"skipping {KNOWN[did][0]}: {exc}")
            if material_path is not None:
                material_path.write_text(json.dumps(materials, indent=2) + "\n")
        # every (model, account, vote) call is independent, but cocore's
        # decentralized serving drowns under a full burst — bound concurrency
        sem = asyncio.Semaphore(int(os.environ.get("JUDGE_CONCURRENCY", "12")))
        timings = {}
        usage = {}

        async def bounded(model, did, v):
            async with sem:
                started = time.monotonic()
                usage[(model, did, v)] = {}
                result = await ask(client, st, model, materials[did][v], usage[(model, did, v)])
                timings[(model, did, v)] = time.monotonic() - started
                return result

        tasks = {
            (model, did, v): asyncio.create_task(bounded(model, did, v))
            for model in models
            for did in materials
            for v in range(VOTES)
        }
        results = {k: await t for k, t in tasks.items()}
        if output := os.environ.get("JUDGE_OUTPUT"):
            Path(output).write_text(json.dumps({
                "provider": PROVIDER,
                "prompt_sha256": hashlib.sha256((PROMPT_HEAD + PROMPT_TAIL).encode()).hexdigest(),
                "materials_sha256": hashlib.sha256(json.dumps(materials, sort_keys=True).encode()).hexdigest(),
                "effort": os.environ.get("JUDGE_EFFORT", "medium") if PROVIDER == "anthropic" else None,
                "skipped": [did for did in KNOWN if did not in materials],
                "votes": [{"model": model, "did": did, "account": KNOWN[did][0],
                           "truth": KNOWN[did][1], "vote": vote, "verdict": verdict,
                           "reason": reason, "seconds": timings[(model, did, vote)],
                           "usage": usage[(model, did, vote)]}
                          for (model, did, vote), (verdict, reason) in results.items()],
            }, indent=2) + "\n")

        print(f"{'model':<45} {'account':<30} truth  votes      verdict")
        scores: dict[str, int] = {}
        for model in models:
            for did in materials:
                name, truth = KNOWN[did]
                votes = []
                for v in range(VOTES):
                    verdict, note = results[(model, did, v)]
                    votes.append(verdict)
                    if verdict is None:
                        print(f"  ! vote {v} inconclusive ({note})")
                machine = sum(1 for x in votes if x is True)
                human = sum(1 for x in votes if x is False)
                verdict = True if machine >= 2 else False if human >= 2 else None
                ok = "✓" if verdict == truth else "✗"
                scores[model] = scores.get(model, 0) + (verdict == truth)
                vs = "".join("M" if x else "?" if x is None else "H" for x in votes)
                print(f"{model:<45} {name:<30} {'M' if truth else 'H'}      {vs:<10} {ok}")
        print()
        for model, s in scores.items():
            print(f"{model}: {s}/{len(materials)}")
        if len(materials) != len(KNOWN) or any(scores.get(model, 0) != len(KNOWN) for model in models):
            raise SystemExit(1)


def load_materials(path: Path) -> dict[str, list[str]]:
    materials = json.loads(path.read_text())
    if not isinstance(materials, dict) or any(
        did not in KNOWN or not isinstance(slices, list) or len(slices) != VOTES
        or any(not isinstance(s, str) or not s.strip() for s in slices)
        for did, slices in materials.items()
    ):
        raise ValueError("invalid saved vote materials")
    return materials


if __name__ == "__main__":
    asyncio.run(main())
